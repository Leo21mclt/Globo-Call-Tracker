{
  "manifest_version": 3,
  "name": "Globo Call Tracker",
  "version": "2.0.6",
  "description": "Auto-tracks Globo calls and logs billable minutes.",
  "permissions": ["storage", "tabs", "alarms", "unlimitedStorage"],
  "host_permissions": [
    "https://*.globohq.com/*",
    "https://globohq.com/*",
    "https://*.deputy.com/*"
  ],
  "action": {
    "default_title": "Call Tracker",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.globohq.com/*", "https://globohq.com/*"],
      "js": ["content/video-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.globohq.com/*", "https://globohq.com/*"],
      "css": ["content/dark-mode.css"],
      "js": ["content/content-script.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["https://*.deputy.com/*"],
      "js": ["content/deputy-sync.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/video-bridge.js", "content/dark-mode.css"],
      "matches": ["https://*.globohq.com/*", "https://globohq.com/*"]
    }
  ]
}
