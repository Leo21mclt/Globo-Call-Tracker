{
  "manifest_version": 3,
  "name": "Globo Call Tracker",
  "version": "1.0.2",
  "description": "Auto-tracks Globo calls and logs billable minutes.",
  "permissions": ["storage", "tabs", "scripting", "alarms"],
  "host_permissions": [
    "https://www.globohq.com/*",
    "https://globo.na.deputy.com/*",
    "https://api.github.com/*"
  ],
  "action": {
    "default_title": "Call Tracker",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.globohq.com/*"],
      "js": ["content/video-accept-spy.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.globohq.com/*"],
      "js": ["content/content-script.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["https://*.deputy.com/*"],
      "js": ["content/deputy-scraper.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/video-accept-spy.js"],
      "matches": ["https://www.globohq.com/*"]
    }
  ]
}
